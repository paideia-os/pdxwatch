# pdxwatch -- paideia-as build manifest
#
# Wave: R102 userland graphical stack -- reference apps
# Milestone: M1 (scaffold + sys_taskinfo aggregation collectors)
# Doc: paideia-os monorepo -- design/graphics/r102-user-plan.md §2.8
#      (system-monitor GUI: role + data source + widget layout)
#      and §4.8 (per-issue landing plan).
#
# pdxwatch is a userspace TOOL binary (a system-monitor GUI) built
# on top of libpdx-gfx + libpdx-event + libpdx-font. Unlike a
# library (kind = library, no _start), pdxwatch is a program a user
# launches at the shell prompt -- kind = tool, one _start, one
# output ELF.
#
# ---------------------------------------------------------------------
# M1-001 real-body landing (paideia-os/pdxwatch#11, v1.1-A)
# ---------------------------------------------------------------------
#
# Scope: app scaffold + fixed-tick sys_taskinfo aggregation collectors
# populating an in-memory CollectSnapshot; Main::main dispatch loop
# runs collect_init + a bounded collect_tick iterate + sys_exit clean
# exit. src/collectors.pdx and src/main.pdx land together at v1.1-A
# (the R102.M1-001 issue's stub-body concept is retired -- see
# src/collectors.pdx §V1.1-A "RETIRE THE STUB BODY" LANDING for the
# design rationale).
#
# Every source enumerated below with an M-tag beyond M1-001 is a
# milestone forward-declaration and will have a `sources:` entry
# added as its landing round writes it. The per-file `paideia-as
# build --emit elf64` step in tools/build.sh compiles every listed
# source into a loose ELF64 object under build-out/; the final link
# into build-out/pdxwatch (with a real _start binder) is a downstream
# packaging step that lands with M1-005 -- until then this manifest
# describes a growing loose-object set, not a linkable binary.
#
# This mirrors the shape postui-top/manifest.pdxproj established for
# the same monorepo-satellite pattern.

name        = pdxwatch
version     = 1.1.0
kind        = tool
# entry lands at M1-005 (_start binder + Main::main call). At M1-001
# there is no _start; Main::main is the forward-declared entry that
# tools/build.sh compiles into build-out/main.o. Named here so the
# M1-005 landing does not need to churn this manifest.
entry       = Main::main                    # DEFERRED until M1-005; see STATUS.md
output      = build-out/pdxwatch
caps_decl   = caps.decl

# --- Source list (order-insensitive; paideia-as resolves module deps
# from `module <Basename> = structure { ... }` headers). Every file
# listed below is compiled into build-out/<basename>.o by
# tools/build.sh. M1-001 (v1.1-A) seeds src/collectors.pdx +
# src/main.pdx; the M1-002..M4 landings each add their own source
# entry as the module body lands.
sources:
  - src/collectors.pdx            # M1-001: CollectSnapshot + collect_init + collect_tick sys_taskinfo aggregator
  - src/main.pdx                  # M1-001: Main::main dispatch loop + pw_sys_exit
  - src/widget_cpu.pdx            # M2-001 (pdxwatch#3): CPU bar-per-core widget (with libpdx-gfx/font stubs)
  - src/widget_mem.pdx            # M2-002 (pdxwatch#4): memory tri-color widget (used/cached/free segments, mirrors widget_cpu.pdx stub shape)
  - src/widget_net.pdx            # M2-003 (pdxwatch#5): network sparkline widget (60-sample ring, staircase draw_line stub, mirrors widget_cpu.pdx/widget_mem.pdx stub shape)
  - src/input.pdx                 # M3-001 (pdxwatch#6): click-cycle detail-toggle + 'q'-quit dispatch (libpdx-event.M3-001 queue drain STUBBED; follow-up wire-in issue tracked separately)
  # - src/argv.pdx                # M1-002: argv parser (deferred; blocks on libpdx-argv v1.1.0 in the same wave)
  # v1.1-B landed the SysStatRecord@0.1 emit path INSIDE
  # src/collectors.pdx (pw_sys_semantic_send wrapper + Phase D-bis
  # emit block in collect_tick) rather than as a separate
  # src/semantic_emit.pdx module -- the emit is a single call plus a
  # two-branch counter update, tightly coupled to the just-populated
  # snapshot, so extracting it into its own module would fragment
  # the collect-and-publish round without adding any reuse surface
  # (pdxwatch is the sole caller, and any downstream schema pdxwatch
  # emits later will reuse the same in-file wrapper).

# --- Library dependencies -----------------------------------------------
# libpdx-gfx / libpdx-event / libpdx-font are the primary graphical
# stack dependencies; M1-002+ will link their object sets into the
# pdxwatch ELF. At M1-001 pdxwatch's collectors module is pure
# userspace with two sys_* wrappers and no library calls yet -- the
# dependencies are declared here so the M1-002 window-creation
# landing does not have to introduce them. Version floors match
# design/graphics/r102-user-plan.md §3.2 / §3.3 / §3.1 M1 landings.
deps:
  - libpdx-gfx   @ ^0.1           # M1-002: surface_open (480x360 KIND_SURFACE)
  - libpdx-event @ ^0.1           # M3-001: event_next / event_poll
  - libpdx-font  @ ^0.1           # M2-001..M2-003: gfx_draw_glyph label rendering

# --- Test targets ------------------------------------------------------
# Populated starting M4-001 (seeded-stat render smoke). Every entry
# below becomes a `paideia-as build --tests` target once the
# corresponding issue lands. Fail-code family bands for pdxwatch per
# src/collectors.pdx §Error band:
#   collect_tick fingerprint         0xFFFFE2F0..0xFFFFE2FF   (M4-001)
#   click-cycle state (pdxwatch#8)   0xFFFFE2C0..0xFFFFE2CB   (M4-002)
#   'q'-quit state (pdxwatch#9)      0xFFFFE2D0..0xFFFFE2DB   (M4-003)
tests:
  - tests/test_seeded_stat_smoke.pdx   # M4-001 (pdxwatch#7): seeded-stat
                                       # render smoke -- bypasses real
                                       # sys_taskinfo aggregation, writes
                                       # fixture values (4 CPUs @ 50%, 8 GB
                                       # used, task_seen=15 net-activity
                                       # proxy) directly into a private
                                       # CollectSnapshot .bss slot, drives
                                       # cpu/mem/net_widget_render against
                                       # a private 256x128 BGRA back-buffer,
                                       # computes per-widget sum-of-qwords
                                       # digests over CPU rows [0..79],
                                       # mem rows [84..93], net rows
                                       # [96..127], compares to hardcoded
                                       # expected values, emits 'pdxwatch
                                       # seeded-stat ok' fingerprint via
                                       # SC+ sysno 12 sys_debug_puts on
                                       # all-pass. Fail-code band
                                       # 0xFFFFE2F0..0xFFFFE2F5 per the
                                       # M4-001 reservation above.
                                       # Expected-digest constants are
                                       # PLACEHOLDERS (0xFFFFFFFFFFFFFFFF)
                                       # that ALWAYS fail on the first run
                                       # -- see §PLACEHOLDER-FINGERPRINT
                                       # POLICY in the source file for
                                       # the freeze-after-first-green
                                       # procedure.
  - tests/test_click_cycle_smoke.pdx   # M4-002 (pdxwatch#8): click-cycle
                                       # encoder-half smoke -- state machine
                                       # + scripted-click witness. Lands
                                       # ahead of M3-001 (blocked on
                                       # libpdx-event.M3) so the transition
                                       # contract (compact <-> expanded
                                       # cycle, sub-bar render witness,
                                       # idempotent-under-toggle) is
                                       # testable at every build; the
                                       # M3-001 substrate wire-in
                                       # (event_next -> pcc_state_click)
                                       # is deferred, but this module's
                                       # pcc_run_all() gates the paideia-os
                                       # QEMU smoke that emits the
                                       # 'pdxwatch click-cycle ok'
                                       # serial-console fingerprint.
  - tests/test_q_quit_smoke.pdx        # M4-003 (pdxwatch#9): 'q'-quit
                                       # encoder-half smoke -- keypress
                                       # state machine + scripted 'q'
                                       # witness. Lands with the same
                                       # v1.1-style leapfrog as #8: ahead
                                       # of M3-001 (blocked on libpdx-
                                       # event.M3), so the transition
                                       # contract (baseline-clean,
                                       # 'q'-raises-quit with clean
                                       # exit_status=0, non-'q' keypress
                                       # counts but does NOT raise quit)
                                       # is testable at every build. The
                                       # M3-001 substrate wire-in
                                       # (event_next -> pqs_state_key)
                                       # is deferred, but this module's
                                       # pqs_run_all() gates the paideia-os
                                       # QEMU smoke that emits the
                                       # 'pdxwatch quit ok' serial-console
                                       # fingerprint. Fail-code band
                                       # 0xFFFFE2D0..0xFFFFE2DB (adjacent
                                       # to #8's 0xFFFFE2C0..CB).
  # (M4-001 seeded-stat smoke LANDED as tests/test_seeded_stat_smoke.pdx
  # above; the "KIND_SYS_STAT seeding primitive" prerequisite noted in
  # the forward-declaration was resolved by bypassing the syscall path
  # entirely -- the smoke writes fixture values directly into a private
  # CollectSnapshot .bss slot, dodging the cross-repo dependency.)

# --- Documentation targets ---------------------------------------------
# .pdxdoc file(s) shipped at M5 packaging time.
docs:
  # (empty at M1-001; M5-001 adds doc/pdxwatch.pdxdoc)

# --- Paideia-as compliance flags ---------------------------------------
# Same invariant set postui-top / postui / shell / libpdx-* satellites
# observe. A build under a non-conforming paideia-as revision refuses
# fast in tools/build.sh's version-floor check.
compliance:
  - module-basename-pascal        # module <BasenamePascalCase>, no dir prefix
  - no-test-mnemonic              # zero-check via cmp reg, 0
  - cmp-imm32-only                # cmp reg, imm <= 0x7FFFFFFF; else stage via r11
  - r11-scratch                   # r11 is not preserved across calls
  - byte-load-zero-then-mov_b     # xor rax, rax; mov_b rax, [ptr]
  - sysv-push-pop-parity          # rsp % 16 == 0 at every nested call

# --- Release policy (M5-001) -------------------------------------------
# Dual-signed release mirroring postui-top / shell shape. Lands at
# M5-001 (pdxwatch v1.0.0 release closer). ML-DSA-65 is the primary
# post-quantum signer; Ed25519 rides as a secondary classical signer
# per the same dual-sign policy postui.M5-003 and shell.M5-001
# established. `pkg install pdxwatch` requires BOTH signatures to
# verify.
release:
  signer_author: snunez+pdxwatch-author@paideia-os.dev
  signer_root:   paideia-os-release-root@paideia-os.dev
  mldsa_level:   65
  ed25519:       required
  mirror_target: pkgs.paideia-os
  tarball:       pdxwatch-v1.0.0.tar.gz
  manifest_kind: satellite-tool
